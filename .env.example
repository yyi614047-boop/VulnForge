# Planner configuration. Export these values in your shell or load this file
# with your local environment tooling. Never commit real secrets.
OPENAI_API_KEY=
PLANNER_MODEL=gpt-4o-mini
PLANNER_MAX_STEPS=5

# New document pipeline: --model enables research synthesis and structured planning.
# --dense enables real embedding calls. Omit it to use local BM25 only.
RAG_EMBEDDING_MODEL=
# Local CPU setup is applied by scripts/run_embedding_experiment.ps1:
# RAG_EMBEDDING_PROVIDER=local
# RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# RAG_EMBEDDING_DEVICE=cpu
# RAG_MODEL_CACHE=.cache/embedding-models
# RAG_LOCAL_FILES_ONLY=1
# Optional OpenAI-compatible endpoint; environment is not loaded automatically.
# OPENAI_BASE_URL=https://your-provider.example/v1
